<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RemoteReports</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <!-- Patched Parquet.Net 6.1.0 fork, built as the assembly PwizParquet so that it can never be confused
       with the stock Parquet.dll: Lib\PwizParquet.dll is copied from skylinedev/Parquet.Net6/
       BinariesForProteoWizard in the maccoss-developers repo (branch PwizParquet, c810c66); copy it again to
       pick up later fixes. Its namespaces are still Parquet.*. It replaces the Parquet.Net package, so the
       packages it depends on are referenced here instead, as listed in that folder's BUILD.md. -->
  <ItemGroup>
    <Reference Include="PwizParquet">
      <HintPath>$(MSBuildThisFileDirectory)Lib\PwizParquet.dll</HintPath>
    </Reference>
    <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <!-- Unmodified copy of pwiz_tools/Skyline/ProtocolBuffers/SkylineDocument.proto, used to decode
       the base64 <transition_data> elements that large documents write instead of <transition>. -->
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.32.1" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0" PrivateAssets="All" />
    <Protobuf Include="Protos\SkylineDocument.proto" GrpcServices="None" />
  </ItemGroup>

</Project>
