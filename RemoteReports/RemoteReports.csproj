<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RemoteReports</RootNamespace>
    <!-- Shown by the version option, with the git commit it was built from. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <!-- Lib\Parquet.dll is a byte-identical copy of the patched Parquet.Net 6.1.0 fork (6.1.0-osprey3) that
       Skyline uses, from pwiz_tools/Shared/Lib/Parquet/Parquet.dll. Skyline references the stock Parquet.Net
       package and copies this file over the package's Parquet.dll after Build, which dotnet publish and
       single-file bundles skip. So this project does not reference the Parquet.Net package at all: it
       references this file, and the packages it depends on are referenced here instead; keep them in step
       with the ones it was built against when replacing it. -->
  <ItemGroup>
    <Reference Include="Parquet">
      <HintPath>$(MSBuildThisFileDirectory)Lib\Parquet.dll</HintPath>
    </Reference>
    <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <!-- Unmodified copy of pwiz_tools/Skyline/ProtocolBuffers/SkylineDocument.proto, used to decode
       the base64 <transition_data> elements that large documents write instead of <transition>. -->
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.32.1" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0" PrivateAssets="All" />
    <Protobuf Include="Protos\SkylineDocument.proto" GrpcServices="None" />
  </ItemGroup>

</Project>
